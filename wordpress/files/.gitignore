theme/dist/

# Banco SQLite do Playground: VERSIONADO, todo dev parte do mesmo banco (ver "Banco de dados"
# no README). Só o transitório fica de fora; um banco em modo WAL não deve ser commitado
# (npm run db:check).
db/**/*.sqlite-wal
db/**/*.sqlite-shm
db/**/*.sqlite-journal
db/*.lock

# Login do WordPress local: cada dev tem o seu (modelo em .env.example)
.env
.env.*
!.env.example
